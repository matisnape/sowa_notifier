# Catalogue page the scraper reads. Not secret.
WBPICAK_URL=

# Telegram channel that receives book notifications.
# Bot API form: "-100" prefix followed by the internal channel number.
WBPICAK_CHANNEL_ID=

# Maintainer's private Telegram chat. Operational warnings only, never book notifications.
SOWA_ADMIN_CHAT_ID=

# Telegram Bot API token. SECRET - keep it in 1Password, never in this repository.
TELEGRAM_BOT_TOKEN=

# Slack incoming webhook used by the original Elixir application. SECRET.
SOWA_NOTIFIER_WEBHOOK_URL=

# Base address of the n8n instance that hosts the workflows.
N8N_BASE_URL=

# Id of the main scraping workflow in n8n. Visible in the workflow URL.
N8N_WORKFLOW_ID=

# Id of the alerting workflow wired to Settings -> Error workflow.
N8N_ERROR_WORKFLOW_ID=

# Id of the telegramApi credential stored inside n8n. The token itself stays in n8n.
N8N_TELEGRAM_CREDENTIAL_ID=
